  "@type": "sc:Dataset",
  "name": "Human-Mouse Atlas of Kidney Myeloid Cells in Lupus Nephritis Reveals Conserved Disease-Associated Macrophages",
  "description": "AMP SLE Phase II kidney scRNA-seq data was used to compared intrarenal myeloid cells in four mouse models and 155 lupus nephritis patients. The authors identified analogous disease-associated monocytes and macrophages between humans and mice that were associated with kidney histological subtypes and disease progression, sharing gene expression and localizing to similar kidney microenvironments as in mice. This cross-species analysis supports the use of mouse functional studies for understanding human lupus nephritis.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "citeAs": "Human-Mouse Atlas of Kidney Myeloid Cells in Lupus Nephritis Reveals Conserved Disease-Associated Macrophages. https://doi.org/10.7303/syn68564337.1",
  "creator": {
    "@type": "sc:Person",
    "name": "Jessica Vera",
    "url": "https://www.synapse.org/#!Profile:3499646"
  },
  "datePublished": "2026-04-02 12:51:30.760",
  "license": "https://creativecommons.org/licenses/by/4.0/",
