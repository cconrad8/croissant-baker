  "@type": "sc:Dataset",
  "name": "Granzyme K+ CD8 T cells form a core population in inflamed human tissue",
  "description": "Using data from the AMP RA Immune Repertoire Profiling dataset, synovial tissue and synovial fluid CD8+ T cells were found to be predominated by a population of effector CD8+ T cells characterized by high expression of granzyme K and low expression of granzyme B and perforin as described in Science Translational Medicine https://doi.org/10.1126/scitranslmed.abo0686.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "citeAs": "Granzyme K+ CD8 T cells form a core population in inflamed human tissue. https://doi.org/10.7303/syn29837062.5",
  "creator": {
    "@type": "sc:Person",
    "name": "Mette Peters",
    "url": "https://www.synapse.org/#!Profile:273995"
  },
