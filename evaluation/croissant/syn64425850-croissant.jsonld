  "@type": "sc:Dataset",
  "name": "Deep immunophenotyping reveals circulating activated lymphocytes in individuals at-risk for rheumatoid arthritis",
  "description": "Using data from the AMP RA.SLE Phase II PBMC CITE-seq and AMP RA.SLE PhaseII CyTOF datasets, investigators examined PBMC gene and protein expression patterns and systematically identified activated lymphocyte phenotypes in RA At-Risk individuals, along with immunophenotypic differences between different At-Risk subpopulations",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "citeAs": "Deep immunophenotyping reveals circulating activated lymphocytes in individuals at-risk for rheumatoid arthritis. https://doi.org/10.7303/syn64425850.5",
  "creator": {
    "@type": "sc:Person",
    "name": "Jessica Vera",
    "url": "https://www.synapse.org/#!Profile:3499646"
  },
